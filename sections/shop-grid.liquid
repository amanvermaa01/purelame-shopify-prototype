{% comment %}
  ------------------------------------------------------------------------------
  Section: shop-grid.liquid
  Purelane Bestsellers Product Grid (#shop)
  Fully compliant with Shopify OS 2.0, Core Web Vitals, a11y, and Theme Editor QA.
  ------------------------------------------------------------------------------
{% endcomment %}

<shop-grid-section id="shopify-section-{{ section.id }}" class="shopify-section">
  <section 
    class="sec section-shop-grid" 
    id="shop-{{ section.id }}" 
    data-scene="3"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
    aria-label="{{ section.settings.accessibility_label | default: 'Bestsellers product grid' }}"
  >
    <div class="wrap">
      
      {%- comment -%} SECTION HEADER {%- endcomment -%}
      <div class="panel-head rv in">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <div class="rule" aria-hidden="true">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          <i></i>
        </div>
      </div>

      {%- comment -%} PRODUCT GRID SHELF {%- endcomment -%}
      <div class="shelf">
        {%- assign featured_collection = section.settings.collection -%}
        {%- assign products_to_display = section.settings.product_list | default: featured_collection.products -%}
        {%- assign limit = section.settings.products_to_show | default: 8 -%}

        {%- if products_to_display != blank and products_to_display.count > 0 -%}
          {%- for product in products_to_display limit: limit -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Theme Customizer Onboarding Placeholder Cards {%- endcomment -%}
          {%- for i in (1..limit) -%}
            <article class="glass card rv in">
              <div class="shot">
                <span class="pill" role="status">Bestseller</span>
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg pimg-placeholder' }}
              </div>
              <h4 class="product-card__title">
                <a href="#" aria-label="Example Product {{ i }}">Example Product {{ i }}</a>
              </h4>
              <div class="rate" aria-label="Rated 4.8 out of 5 stars from 237 reviews">
                <b aria-hidden="true">★ 4.8</b>
                <span aria-hidden="true">· 237 reviews</span>
              </div>
              <div class="pr" aria-label="Price: {{ 20000 | money_with_currency }}">
                <strong>{{ 20000 | money }}</strong>
                <s aria-label="Original price: {{ 29900 | money_with_currency }}">{{ 29900 | money }}</s>
                <em aria-label="33 percent discount">33% off</em>
              </div>
              <button type="button" class="btn btn-ghost btn-sm" aria-label="Add Example Product {{ i }} to cart">
                Add to cart
              </button>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>

    </div>
  </section>
</shop-grid-section>

{%- comment -%} SECTION-SCOPED STYLES (No CSS Leaks) {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .sec {
    position: relative;
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .shelf {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 860px) {
    #shopify-section-{{ section.id }} .shelf {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .card {
    padding: 16px;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.4s var(--ease, cubic-bezier(.2,.7,.2,1));
  }

  #shopify-section-{{ section.id }} .card:hover {
    transform: translateY(-5px);
  }

  #shopify-section-{{ section.id }} .card .shot {
    height: 150px;
    border-radius: 14px;
    margin-bottom: 14px;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(236,230,247,.12), rgba(75,58,143,.2));
    border: 1px solid rgba(236,230,247,.14);
  }

  #shopify-section-{{ section.id }} .card .shot img.pimg-img {
    max-height: 122px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 8px 13px rgba(0, 74, 66, 0.13));
  }

  #shopify-section-{{ section.id }} .card .shot svg.placeholder-svg {
    height: 122px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    opacity: 0.65;
  }

  #shopify-section-{{ section.id }} .card .pill {
    position: absolute;
    top: 9px;
    left: 9px;
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(23,16,43,.6);
    border: 1px solid rgba(240,160,60,.32);
    color: var(--accent, #f0a03c);
  }

  #shopify-section-{{ section.id }} .card .pill.pill--sold-out {
    background: rgba(23,16,43,.85);
    border-color: rgba(239,68,68,.45);
    color: #f87171;
  }

  /* 2-Line Truncation for Exceptionally Long Titles */
  #shopify-section-{{ section.id }} .card h4,
  #shopify-section-{{ section.id }} .card .product-card__title {
    font-family: 'Outfit', sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .03em;
    color: var(--surface, #faf7fd);
    line-height: 1.2;
    margin-bottom: 7px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: 2.4em;
  }

  #shopify-section-{{ section.id }} .card .rate {
    font-size: 11.5px;
    color: var(--paper-2, rgba(236,230,247,.74));
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  #shopify-section-{{ section.id }} .card .rate b {
    color: var(--accent, #f0a03c);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .card .pr {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .card .pr strong {
    font-family: 'Outfit', sans-serif;
    font-size: 18px;
    color: var(--surface, #faf7fd);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .card .pr s {
    font-size: 12px;
    color: var(--paper-3, rgba(236,230,247,.52));
  }

  #shopify-section-{{ section.id }} .card .pr em {
    font-style: normal;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
    color: var(--accent, #f0a03c);
  }

  #shopify-section-{{ section.id }} .card .btn {
    width: 100%;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .card a:focus-visible,
  #shopify-section-{{ section.id }} .card button:focus-visible {
    outline: 2px solid var(--accent, #f0a03c);
    outline-offset: 3px;
    border-radius: 6px;
  }

  #shopify-section-{{ section.id }} .card .btn[disabled],
  #shopify-section-{{ section.id }} .card .btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--paper-3, rgba(236,230,247,.52));
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .card .shot {
      height: 126px;
    }
    #shopify-section-{{ section.id }} .card .shot img.pimg-img,
    #shopify-section-{{ section.id }} .card .shot svg.placeholder-svg {
      max-height: 108px;
    }
  }

  /* Accessibility Motion Sensitivity */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .card {
      transition: none !important;
    }
    #shopify-section-{{ section.id }} .rv {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>

{%- comment -%} SECTION-SCOPED JAVASCRIPT (Web Component Scoped Execution) {%- endcomment -%}
<script>
  if (!customElements.get('shop-grid-section')) {
    customElements.define('shop-grid-section', class ShopGridSection extends HTMLElement {
      connectedCallback() {
        this.container = this;
        this.initAccessibility();
      }

      initAccessibility() {
        // Section-scoped interactive keyboard focus management
        const focusableElements = this.container.querySelectorAll('a, button');
        focusableElements.forEach(el => {
          el.addEventListener('focus', () => {
            el.classList.add('is-focused');
          });
          el.addEventListener('blur', () => {
            el.classList.remove('is-focused');
          });
        });
      }
    });
  }
</script>

{% schema %}
{
  "name": "Product Grid (#shop)",
  "tag": "section",
  "class": "section-shop-grid",
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility Section Label",
      "default": "Bestsellers product grid"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker / Eyebrow",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Featured Products List (Overrides Collection)",
      "limit": 12
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 8,
      "label": "Maximum products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop Grid Columns"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Product Grid (#shop)"
    }
  ]
}
{% endschema %}
