{% comment %}
  ------------------------------------------------------------------------------
  Section: product-grid.liquid
  Purelane Bestsellers Product Grid (#shop)
  Renders collection products using snippet 'product-card.liquid'
  Handles line clamping, sold-out states, and placeholder SVG fallbacks.
  ------------------------------------------------------------------------------
{% endcomment %}

<section 
  class="sec section-shop-grid" 
  id="shop" 
  data-scene="3"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {%- assign featured_collection = section.settings.collection -%}
      {%- assign products_to_display = section.settings.product_list | default: featured_collection.products -%}
      {%- assign limit = section.settings.products_to_show | default: 8 -%}

      {%- if products_to_display != blank and products_to_display.count > 0 -%}
        {%- for product in products_to_display limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Theme Customizer Onboarding Mock Cards {%- endcomment -%}
        {%- for i in (1..limit) -%}
          <article class="glass card rv">
            <div class="shot">
              <span class="pill">Bestseller</span>
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg pimg-placeholder' }}
            </div>
            <h4 class="product-card__title">
              <a href="#">Example Product {{ i }}</a>
            </h4>
            <div class="rate"><b>★ 4.8</b> · 237 reviews</div>
            <div class="pr">
              <strong>{{ 20000 | money }}</strong>
              <s>{{ 29900 | money }}</s>
              <em>33% off</em>
            </div>
            <button type="button" class="btn btn-ghost btn-sm">Add to cart</button>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Grid (#shop)",
  "tag": "section",
  "class": "section-shop-grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker / Eyebrow",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Featured Products List (Overrides Collection)",
      "limit": 12
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 8,
      "label": "Maximum products to show"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Product Grid (#shop)"
    }
  ]
}
{% endschema %}
